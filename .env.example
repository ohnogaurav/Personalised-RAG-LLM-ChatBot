# Google Gemini API Key (Optional if using Groq for chat)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for chat if not using Gemini)
GROQ_API_KEY=your_groq_api_key_here

# JWT Cryptographic Signing Key (Change in production)
JWT_SECRET_KEY=supersecret_dev_key_replace_in_production

# Relational Database URL
DATABASE_URL=sqlite+aiosqlite:///./anubodh.db

# Vector Database (set to "memory" for local zero-config testing)
QDRANT_URL=memory
